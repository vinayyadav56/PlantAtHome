# Staging environment — copy to .env and fill in secrets
# Railway env vars override these at runtime; this file is for CI migrations only.

APP_ENV=staging
APP_DEBUG=false
APP_KEY=base64:REPLACE_ME

DB_CONNECTION=mysql
DB_HOST=RAILWAY_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=RAILWAY_MYSQL_PASSWORD

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

MEDIA_DISK=public

DEFAULT_LANGUAGE=en
DUMMY_DATA_PATH=plantathome

ADMIN_EMAIL=admin@plantathome.in
ADMIN_PASSWORD=REPLACE_ME
ADMIN_NAME="PlantAtHome Admin"

RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# ── Social login ──
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
LINKEDIN_CLIENT_ID=REPLACE_ME
LINKEDIN_CLIENT_SECRET=REPLACE_ME
LINKEDIN_REDIRECT_URI=https://staging.plantathome.in/api/auth/callback/linkedin

# ── OTP login ── ACTIVE_OTP_GATEWAY = global default; SMS_OTP_GATEWAY used for the "sms" channel
ACTIVE_OTP_GATEWAY=msg91
SMS_OTP_GATEWAY=msg91
MSG91_AUTH_KEY=REPLACE_ME
MSG91_TEMPLATE_ID=REPLACE_ME
MSG91_SENDER=REPLACE_ME
# WhatsApp (Meta Cloud API) — set ACTIVE_OTP_GATEWAY=whatsapp to make it the
# default, or leave it and let clients pass channel=whatsapp per request.
# Templates must be APPROVED in the Meta Business Manager before they deliver.
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
WHATSAPP_ACCESS_TOKEN=REPLACE_ME
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=REPLACE_ME
WHATSAPP_OTP_LANG=en
# true only if the approved AUTHENTICATION template has a copy-code button
WHATSAPP_OTP_HAS_BUTTON=false
WHATSAPP_OTP_TTL_MINUTES=5
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_NOTIFY_TEMPLATE=REPLACE_ME
WHATSAPP_NOTIFY_LANG=en
# Inbound webhook: the token you type into Meta's webhook config, and the App
# Secret used to verify X-Hub-Signature-256. Without the secret events are
# accepted but logged as UNVERIFIED; without the token the handshake 404s.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=REPLACE_ME
WHATSAPP_APP_SECRET=REPLACE_ME

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=REPLACE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@plantathome.in

IMAGE_SERVICE_API_KEY=REPLACE_ME

SANCTUM_STATEFUL_DOMAINS=plantathome-shop-staging.vercel.app,plantathome-admin-staging.vercel.app
